<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bubble_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bubble_background"
    android:backgroundTint="#5CC5EA"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/bubble_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_bolt" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bubble_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="80% · 43°C" />

            <TextView
                android:id="@+id/bubble_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.9"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                tools:text="4.5 W · Home stretch" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bubble_expand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/bubble_charge_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Charge  64% / 80%" />

        <ProgressBar
            android:id="@+id/bubble_charge_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="210dp"
            android:layout_height="7dp"
            android:layout_marginTop="2dp"
            android:max="100"
            android:progressBackgroundTint="#66FFFFFF"
            android:progressTint="#FFFFFF" />

        <TextView
            android:id="@+id/bubble_overheat_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Temp  36.0°C / 42°C" />

        <ProgressBar
            android:id="@+id/bubble_overheat_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="210dp"
            android:layout_height="7dp"
            android:layout_marginTop="2dp"
            android:max="100"
            android:progressBackgroundTint="#66FFFFFF"
            android:progressTint="#FFFFFF" />

        <TextView
            android:id="@+id/bubble_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.85"
            android:text="Tap to collapse · long-press to open"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
